# ==============================================================================
# NotesShala Environment Variables Configuration Template
# Copy this file to '.env' or '.env.local' and fill in your actual credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Kinde Authentication (Next.js App & User Login/Sign Up)
# Get credentials from: https://kinde.com -> Settings -> Applications -> [Your Next.js App]
# ------------------------------------------------------------------------------
# Your Kinde Application Client ID (from Kinde Dashboard -> App Details)
KINDE_CLIENT_ID=your_kinde_client_id

# Your Kinde Application Client Secret
KINDE_CLIENT_SECRET=your_kinde_client_secret

# Your Kinde Domain / Issuer URL (e.g. https://yourbusiness.kinde.com)
KINDE_ISSUER_URL=https://your-domain.kinde.com

# Base URL of your website (http://localhost:3000 for local dev or your production domain)
KINDE_SITE_URL=http://localhost:3000

# URL to redirect users to after they log out (e.g. http://localhost:3000)
KINDE_POST_LOGOUT_REDIRECT_URL=http://localhost:3000

# URL to redirect users to after successful login/sign-up (e.g. http://localhost:3000)
KINDE_POST_LOGIN_REDIRECT_URL=http://localhost:3000


# ------------------------------------------------------------------------------
# 2. Server & Client Ports
# ------------------------------------------------------------------------------
# Port for the Node.js / Express backend server
PORT=5000

# URL of the Next.js frontend application (used for CORS and redirects)
CLIENT_URL=http://localhost:3000


# ------------------------------------------------------------------------------
# 3. Database Configuration (MongoDB Atlas)
# ------------------------------------------------------------------------------
# MongoDB connection URI from MongoDB Atlas (e.g. mongodb+srv://<username>:<password>@cluster0.mongodb.net/notes_db?retryWrites=true&w=majority)
MONGO_URI=mongodb+srv://username:password@cluster-url/database-name?retryWrites=true&w=majority


# ------------------------------------------------------------------------------
# 4. Google Drive Storage (Primary Note Upload Storage)
# ------------------------------------------------------------------------------
# ID of the Google Drive folder where uploaded notes & PDFs will be stored
# (Found in the URL: https://drive.google.com/drive/folders/<GOOGLE_DRIVE_PARENT>)
# Note: Ensure the folder is shared with your Service Account email (from cred.json) as 'Editor'.
GOOGLE_DRIVE_PARENT=your_google_drive_folder_id

# Optional Google OAuth credentials (if not using cred.json service account)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REFRESH_TOKEN=your_google_refresh_token


# ------------------------------------------------------------------------------
# 5. Cloudinary Storage (Automatic Fallback & Media Hosting)
# Get credentials from: https://cloudinary.com -> Dashboard
# ------------------------------------------------------------------------------
# Your Cloudinary Cloud Name
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name

# Your Cloudinary API Key
CLOUDINARY_API_KEY=your_cloudinary_api_key

# Your Cloudinary API Secret
CLOUDINARY_API_SECRET=your_cloudinary_api_secret


# ------------------------------------------------------------------------------
# 6. Email / SMTP Notifications (Optional)
# ------------------------------------------------------------------------------
# Sender email displayed on outgoing messages
EMAIL_FROM=your_email@domain.com

# SMTP username / login email (e.g. your Gmail address)
SMTP_USER=your_smtp_username@gmail.com

# SMTP App password (generate an App Password in Google Account -> Security)
SMTP_PASS=your_smtp_app_password

